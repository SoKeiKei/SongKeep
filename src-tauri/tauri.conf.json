{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SongKeep",
  "version": "0.3.0",
  "identifier": "com.sokei.songkeep",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SongKeep · Suno 歌曲下载",
        "width": 960,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "backgroundColor": "#f7f5f0"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright © 2026 SoKei",
    "shortDescription": "Suno 分享歌曲下载工具",
    "longDescription": "无需登录即可读取并下载 Suno 分享歌曲和歌词。",
    "icon": [
      "../assets/songkeep.png",
      "../assets/songkeep.ico",
      "../assets/songkeep.icns"
    ],
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
